generator client {
  provider = "prisma-client-js"
  output   = "../../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model BrandSetting {
  id                String   @id @default(cuid())
  businessStartTime String   @default("08:00")
  businessEndTime   String   @default("21:00")

  therapistIncentiveType     String   @default("FIXED") // FIXED, DURATION_BASED
  therapistIncentiveAmount   Decimal  @default(0)
  therapistIncentiveDuration Int      @default(60) // in minutes

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
