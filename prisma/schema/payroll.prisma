model SalaryComponent {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  isDeduction Boolean  @default(false)
  type        String   @default("FIXED") // FIXED, PERCENTAGE, PER_ATTENDANCE
  amount      Decimal? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffSalaryComponents StaffSalaryComponent[]
}

model StaffSalaryComponent {
  id                String   @id @default(cuid())
  staffId           String
  salaryComponentId String
  amount            Decimal? // Override default amount if needed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff           Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Cascade)

  @@unique([staffId, salaryComponentId])
}

model Payroll {
  id             String        @id @default(cuid())
  staffId        String
  monthPeriod    String
  startDate      DateTime
  endDate        DateTime
  baseSalary     Decimal
  totalAllowance Decimal
  totalDeduction Decimal
  netSalary      Decimal
  status         String        @default("DRAFT") // DRAFT, PAID
  items          PayrollItem[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  staff          Staff         @relation(fields: [staffId], references: [id])

  @@unique([staffId, monthPeriod])
}

model PayrollItem {
  id          String   @id @default(cuid())
  payrollId   String
  name        String
  amount      Decimal
  type        String   // ALLOWANCE, DEDUCTION
  isManual    Boolean  @default(false)
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payroll     Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
}
