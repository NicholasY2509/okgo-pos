model Role {
  id          String  @id @default(cuid())
  name        String  @unique // e.g. "Admin", "Cashier", "Manager"
  description String?

  permissions  RolePermission[]
  branchStaffs BranchStaff[]
  users        User[]
}

model Permission {
  id          String  @id @default(cuid())
  action      String  @unique // e.g. "sales:create", "inventory:read"
  description String?

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model WorkPosition {
  id          String   @id @default(cuid())
  name        String // e.g., Therapist, Receptionist
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff          Staff[]
  categories     Category[]
  incentiveRules IncentiveRule[]
}

model IncentiveRule {
  id                   String @id @default(cuid())
  name                 String

  // e.g., "SERVICE_PRICE_PERCENTAGE", "VOUCHER_SALES_TIERED", "TOTAL_SALES_TIERED", "FIXED_AMOUNT"
  ruleType String

  flatAmount     Decimal?
  flatPercentage Decimal?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targetWorkPositions WorkPosition[]
  tiers               IncentiveTier[]
}

model IncentiveTier {
  id              String @id @default(cuid())
  incentiveRuleId String

  minTarget Decimal // e.g. 0
  maxTarget Decimal? // e.g. 80000000, null means infinity

  // The commission given if within this tier
  amount     Decimal? // If it's a fixed amount bonus
  percentage Decimal? // If it's a percentage bonus, e.g. 0.5%

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incentiveRule IncentiveRule @relation(fields: [incentiveRuleId], references: [id], onDelete: Cascade)
}

model Staff {
  id             String  @id @default(cuid())
  firstName      String
  lastName       String
  phone          String?
  email          String?
  isActive       Boolean @default(true)
  workPositionId String
  staffIdNumber  String?

  // Kiosk Login Fields
  username String? @unique
  pinHash  String?
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workPosition           WorkPosition            @relation(fields: [workPositionId], references: [id])
  staffUsers             StaffUser[]
  serviceSessions        ServiceSession[]
  branchStaffs           BranchStaff[]
  attendanceWorkingHours AttendanceWorkingHour[]
  staffMachines          StaffMachine[]
  attendanceMachineLogs  AttendanceMachineLog[]
  attendances            Attendance[]
  staffSalaries          StaffSalary[]
  staffSalaryComponents  StaffSalaryComponent[]
  payrolls               Payroll[]
  staffIncentives        StaffIncentive[]
}

model StaffUser {
  id        String   @id @default(cuid())
  staffId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([staffId, userId])
}

model StaffSalary {
  id            String   @id @default(cuid())
  staffId       String
  baseSalary    Decimal  @default(0)
  effectiveDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, effectiveDate(sort: Desc)])
}
