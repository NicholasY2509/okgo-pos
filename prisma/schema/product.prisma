model Category {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  targetWorkPositionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  products           Product[]
  targetWorkPosition WorkPosition? @relation(fields: [targetWorkPositionId], references: [id])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Decimal  @default(0)
  duration        Int? // Duration in minutes
  isVip           Boolean  @default(false)
  isActive        Boolean  @default(true)
  showOnMarketing Boolean  @default(false)
  image           String?
  categoryId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id])
  voucherPackets VoucherPacket[]
}

model VoucherPacket {
  id String @id @default(cuid())

  name       String
  codeSuffix String?

  price Decimal

  totalVisitCount   Int?
  totalCreditAmount Decimal?

  validityDays Int?
  isActive     Boolean @default(true)

  cashierIncentiveType   String?  @default("FIXED") // FIXED, PERCENTAGE
  cashierIncentiveAmount Decimal? @default(0)

  productId String?

  customerVouchers CustomerVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}
